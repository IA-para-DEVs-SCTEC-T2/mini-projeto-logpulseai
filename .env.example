# ============================================================================
# LogPulse IA — Variáveis de Ambiente
# ============================================================================
# Copie este arquivo para .env e configure os valores para seu ambiente.
# Todas as variáveis usam o prefixo LOGPULSE_ conforme pydantic-settings.

# ============================================================================
# Ollama / IA
# ============================================================================
# URL base do servidor Ollama (inclui /v1 para compatibilidade OpenAI SDK)
LOGPULSE_OLLAMA_BASE_URL=http://localhost:11434/v1

# Modelo LLM a usar (padrão: llama3)
LOGPULSE_OLLAMA_MODEL=llama3

# Timeout para chamadas ao Ollama em segundos
LOGPULSE_OLLAMA_TIMEOUT=30

# Número máximo de retries com backoff exponencial
LOGPULSE_OLLAMA_MAX_RETRIES=3

# ============================================================================
# Database
# ============================================================================
# Caminho para o arquivo SQLite (relativo ao diretório de execução)
LOGPULSE_DATABASE_URL=logpulse.db

# ============================================================================
# Parser (Drain3)
# ============================================================================
# Profundidade da árvore de parsing
LOGPULSE_DRAIN_DEPTH=4

# Threshold de similaridade para agrupamento
LOGPULSE_DRAIN_SIM_TH=0.4

# ============================================================================
# Analyzer
# ============================================================================
# Número mínimo de erros na janela para detectar spike
LOGPULSE_SPIKE_THRESHOLD=10

# Tamanho da janela deslizante em segundos
LOGPULSE_SPIKE_WINDOW_SECONDS=60

# ============================================================================
# API
# ============================================================================
LOGPULSE_API_TITLE=LogPulse IA
LOGPULSE_API_VERSION=0.1.0
LOGPULSE_API_DEBUG=false

# ============================================================================
# Notas
# ============================================================================
# - Certifique-se de que o Ollama está rodando: ollama serve
# - Para usar um modelo diferente: ollama pull <modelo>
# - Variáveis de ambiente têm precedência sobre qualquer arquivo de config
